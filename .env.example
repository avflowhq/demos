# Copy to .env.local and fill in what the demos you want to run need.
# The homepage shows which of these it can see.

# ---------------------------------------------------------------------------
# AVFlow — required by every demo. Create a key in https://console.avflow.dev
# ---------------------------------------------------------------------------
AVFLOW_API_KEY=
AVFLOW_API_URL=https://api.avflow.dev

# ---------------------------------------------------------------------------
# LiveKit — required by every demo. A LiveKit Cloud project or self-hosted server.
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# RTMP destination — co-host and voice room demos.
# Join TikTok/YouTube/Twitch's server URL and stream key into one URL, or point
# at a local SRS: rtmp://localhost/live/demo
# ---------------------------------------------------------------------------
RTMP_PUSH_URL=

# ---------------------------------------------------------------------------
# Public tunnel — voice room demo only.
# AVFlow's headless browser loads /overlay/captions from here, so localhost will
# not work. Start a tunnel and paste its https URL:
#   cloudflared tunnel --url http://localhost:3000
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Object storage — meeting recording demo. S3, or anything S3-compatible.
# Set S3_ENDPOINT for R2/MinIO (path-style addressing is applied automatically).
# ---------------------------------------------------------------------------
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PATH_PREFIX=avflow-demos

# ---------------------------------------------------------------------------
# Meeting notes — summarises the transcript AVFlow produced. Not an AVFlow node.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ---------------------------------------------------------------------------
# Optional: bring your own ASR / voice agent vendor.
#
# Leave these empty and AVFlow uses platform-managed credentials — you need no
# vendor keys at all. Set BOTH the provider and the key to switch a node to
# BYOK; setting only one is rejected at submit time.
#
# asr:         deepgram | openai | elevenlabs | google | azure
# voice_agent: openai | gemini | deepgram | cloudflare
#
# `translate` is platform-managed only and has no BYOK option.
# ---------------------------------------------------------------------------
ASR_PROVIDER=
ASR_API_KEY=
VOICE_AGENT_PROVIDER=
VOICE_AGENT_API_KEY=
